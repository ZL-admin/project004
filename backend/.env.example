# ===== LLM 后端选择：mock / ollama / openai =====
# mock   -> 无需任何 key/网络，返回假数据，专心调流程和前端
# ollama -> 本地开源模型 (http://localhost:11434)
# openai -> OpenAI 兼容端点 (Gemini 免费层 / Groq / OpenRouter / 付费)
LLM_BACKEND=mock

# --- ollama 模式 ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- openai 兼容模式 ---
# Gemini 免费层: https://generativelanguage.googleapis.com/v1beta/openai
# Groq:          https://api.groq.com/openai/v1
# OpenRouter:    https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.5-flash-lite

# 滑动窗口：最近多少条历史进 prompt（控制 input token / 成本）
HISTORY_WINDOW=20
